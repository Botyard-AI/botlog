{
  "name": "botlog",
  "version": "0.1.0",
  "description": "Lightweight live log viewer for scripts, services, files, and child processes.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "tsx examples/basic.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.20",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^2.1.9"
  }
}
